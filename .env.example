# Copiez ce fichier vers `.env` puis renseignez votre clé API.
#   cp .env.example .env

# --- Obligatoire : clé API Mistral (https://console.mistral.ai/) ---
MISTRAL_API_KEY=

# --- Modèles Mistral ---
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSION=1024
# ⚠️ mistral-small-latest renvoie 429 et mistral-large-latest 403 sur un compte
# à palier limité. open-mistral-7b est le seul modèle de chat toujours disponible.
LLM_MODEL=open-mistral-7b

# --- Qdrant ---
# Port 6343 : voir la note dans docker-compose.yml (le 6333 est déjà occupé
# sur cette machine par une autre instance Qdrant).
QDRANT_URL=http://localhost:6343
QDRANT_API_KEY=
# documents = chunking sémantique ; documents_v2 = fenêtre glissante
QDRANT_COLLECTION=documents_v2

# --- Découpage des documents ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Recherche ---
TOP_K=4

# --- Dossier des documents importés, HORS du dépôt git ---
# Relatif au dossier EKA/. Ne pas pointer vers ../data : c'est le corpus du benchmark.
DATA_DIR=../data_perso

# --- Évaluation (facultatif) : clé du LLM juge d'EnterpriseRAG-Bench ---
# Le juge n'accepte que "openai" ou "anthropic", et lit LLM_API_KEY.
ANTHROPIC_API_KEY=
